# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram User ID (get it from @userinfobot)
# Security: 0 or unset locks out all users (fail-closed)
ALLOWED_USER_ID=0

# Secret token used to authorize WebApp & WebSocket connections
# Leave blank to auto-generate a secure ephemeral key on every boot, or set a fixed secret
SECRET_KEY=change_me_to_a_long_random_secret

# Local FastAPI bind address & port
HOST=127.0.0.1
PORT=8765

# Optional explicit path to cloudflared.exe (leave blank for auto-detection)
CLOUDFLARED_PATH=
